{
  "name": "zemdomu",
  "displayName": "ZemDomu VS Code Extension",
  "publisher": "ZachariasErydBerlin",
  "description": "Semantic accessibility static analysis for HTML, JSX, TSX, and Vue with supported cross-component context",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zemdomu/ZemDomu-extension.git"
  },
  "bugs": {
    "url": "https://github.com/Zemdomu/ZemDomu-extension/issues"
  },
  "funding": "https://buymeacoffee.com/zemdomu",
  "version": "0.0.18",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:vue"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "zemdomu.lintWorkspace",
        "title": "ZemDomu: Scan Workspace for Semantic Accessibility Issues"
      }
    ],
    "keybindings": [
      {
        "command": "zemdomu.lintWorkspace",
        "key": "ctrl+alt+z",
        "mac": "cmd+alt+z",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "ZemDomu VS Code Extension Settings",
      "properties": {
        "zemdomu.run": {
          "type": "string",
          "enum": [
            "onSave",
            "onType",
            "manual",
            "disabled"
          ],
          "default": "onSave",
          "description": "When to run semantic accessibility analysis:\n- onSave: after each file save\n- onType: as you type\n- manual: only via the Scan Workspace command\n- disabled: never run automatically"
        },
        "zemdomu.crossComponentAnalysis": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Analyze supported structural issues across statically resolvable React and Vue component boundaries."
        },
        "zemdomu.crossComponentDepth": {
          "type": "integer",
          "minimum": 0,
          "default": 50,
          "scope": "resource",
          "description": "Maximum local dependency depth followed during cross-component analysis. Set to 0 to analyze only direct entries."
        },
        "zemdomu.devMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable developer diagnostics and performance output."
        },
        "zemdomu.enableVerboseLogging": {
          "type": "boolean",
          "default": false,
          "description": "Emit structured diagnostic lifecycle logs to the ZemDomu output channel."
        },
        "zemdomu.rules.requireSectionHeading": {
          "type": "boolean",
          "default": true,
          "description": "Advisory by default: warn when a <section> has no heading. A heading can support WCAG 2.4.10 (AAA) when that criterion applies."
        },
        "zemdomu.rules.enforceHeadingOrder": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a later heading skips upward levels (for example, <h3> after <h1> without <h2>). The first observed heading does not warn."
        },
        "zemdomu.rules.singleH1": {
          "type": "boolean",
          "default": true,
          "description": "House style: warn if more than one <h1> is used in a document. This rule does not require an <h1> and is not a general WCAG conformance requirement."
        },
        "zemdomu.rules.requireAltText": {
          "type": "boolean",
          "default": true,
          "description": "Warn when an <img> tag is missing alt text or an inline SVG used as an image/control lacks an accessible name."
        },
        "zemdomu.rules.requireLabelForFormControls": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a form control (input, select, textarea) doesn't have an associated label."
        },
        "zemdomu.rules.enforceListNesting": {
          "type": "boolean",
          "default": true,
          "description": "Warn when an <li> element is not a direct child of <ul> or <ol>."
        },
        "zemdomu.rules.requireLinkText": {
          "type": "boolean",
          "default": true,
          "description": "Warn when an <a> tag lacks an accessible name (text, aria-label/aria-labelledby, or labeled content)."
        },
        "zemdomu.rules.requireTableCaption": {
          "type": "boolean",
          "default": true,
          "description": "Advisory by default: warn when a <table> is missing a <caption>. Captions can help satisfy structural requirements such as WCAG 1.3.1 when applicable."
        },
        "zemdomu.rules.preventEmptyInlineTags": {
          "type": "boolean",
          "default": true,
          "description": "Warn when inline tags (strong, em, b, i, etc.) are empty."
        },
        "zemdomu.rules.requireHrefOnAnchors": {
          "type": "boolean",
          "default": true,
          "description": "Warn when an <a> tag is missing a non-empty href attribute."
        },
        "zemdomu.rules.requireButtonText": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a <button> lacks accessible text or aria-label."
        },
        "zemdomu.rules.requireIframeTitle": {
          "type": "boolean",
          "default": true,
          "description": "Warn when an <iframe> is missing a title attribute."
        },
        "zemdomu.rules.requireHtmlLang": {
          "type": "boolean",
          "default": true,
          "description": "Warn when the <html> tag lacks a valid lang attribute."
        },
        "zemdomu.rules.requireImageInputAlt": {
          "type": "boolean",
          "default": true,
          "description": "Warn when <input type=\"image\"> is missing alt text."
        },
        "zemdomu.rules.requireNavLinks": {
          "type": "boolean",
          "default": true,
          "description": "House style: warn when a <nav> contains no links. This is an authoring policy rather than a universal WCAG conformance requirement."
        },
        "zemdomu.rules.uniqueIds": {
          "type": "boolean",
          "default": true,
          "description": "Warn when multiple elements share the same id."
        },
        "zemdomu.rules.noTabindexGreaterThanZero": {
          "type": "boolean",
          "default": true,
          "description": "Warn when tabindex values greater than 0 are used."
        },
        "zemdomu.rules.preventZemdomuPlaceholders": {
          "type": "boolean",
          "default": true,
          "description": "Warn when TODO-ZMD placeholders remain in markup."
        },
        "zemdomu.rules.requireDocumentTitle": {
          "type": "boolean",
          "default": true,
          "description": "Warn when an <html> document is missing a non-empty <title>."
        },
        "zemdomu.rules.requireSingleMain": {
          "type": "boolean",
          "default": true,
          "description": "Warn when an <html> document has zero or multiple <main> landmarks."
        },
        "zemdomu.rules.ariaValidAttrValue": {
          "type": "boolean",
          "default": true,
          "description": "Warn when supported ARIA attributes use invalid static values."
        },
        "zemdomu.rules.requirePageH1": {
          "type": "boolean",
          "default": true,
          "description": "Advisory: warn when a composed page has no deterministically resolved H1 heading."
        },
        "zemdomu.severity.requireSectionHeading": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for the requireSectionHeading rule."
        },
        "zemdomu.severity.enforceHeadingOrder": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for the enforceHeadingOrder rule."
        },
        "zemdomu.severity.singleH1": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for the singleH1 rule."
        },
        "zemdomu.severity.requireAltText": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for the requireAltText rule."
        },
        "zemdomu.severity.requireLabelForFormControls": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for the requireLabelForFormControls rule."
        },
        "zemdomu.severity.enforceListNesting": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for the enforceListNesting rule."
        },
        "zemdomu.severity.requireLinkText": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for the requireLinkText rule."
        },
        "zemdomu.severity.requireTableCaption": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for the requireTableCaption rule."
        },
        "zemdomu.severity.preventEmptyInlineTags": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for the preventEmptyInlineTags rule."
        },
        "zemdomu.severity.requireHrefOnAnchors": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for the requireHrefOnAnchors rule."
        },
        "zemdomu.severity.requireButtonText": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for the requireButtonText rule."
        },
        "zemdomu.severity.requireIframeTitle": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for the requireIframeTitle rule."
        },
        "zemdomu.severity.requireHtmlLang": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for the requireHtmlLang rule."
        },
        "zemdomu.severity.requireImageInputAlt": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for the requireImageInputAlt rule."
        },
        "zemdomu.severity.requireNavLinks": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for the requireNavLinks rule."
        },
        "zemdomu.severity.uniqueIds": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for the uniqueIds rule."
        },
        "zemdomu.severity.noTabindexGreaterThanZero": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for the noTabindexGreaterThanZero rule."
        },
        "zemdomu.severity.preventZemdomuPlaceholders": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for the preventZemdomuPlaceholders rule."
        },
        "zemdomu.severity.requireDocumentTitle": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for the requireDocumentTitle rule."
        },
        "zemdomu.severity.requireSingleMain": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for the requireSingleMain rule."
        },
        "zemdomu.severity.ariaValidAttrValue": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for the ariaValidAttrValue rule."
        },
        "zemdomu.severity.requirePageH1": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ],
          "default": "warning",
          "description": "Severity for the requirePageH1 rule."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -w",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --minify --external:vscode --outfile=dist/extension.js",
    "vscode:prepublish": "npm test && npm run bundle",
    "package": "vsce package --no-dependencies --out dist/zemdomu.vsix && node tests/package-contents.test.js && node tests/package-size.test.js --vsix",
    "test:rule-oracle": "node tests/run-rule-oracle.js",
    "test": "npm run compile && npm run bundle && node tests/run-modes.test.js && node tests/issue-tracker.test.js && node tests/race-stress.test.js && node tests/inline-disable.test.js && node tests/multi-root.test.js && node tests/linter-labels.test.js && node tests/all-rules.test.js && node tests/rule-surface.test.js && node tests/canonical-diagnostics.test.js && node tests/unique-ids.test.js && node tests/cross-component-extension.test.js && node tests/extension-cross-component.test.js && node tests/vue-extension.test.js && node tests/quick-fixes.test.js && node tests/full-document-quick-fixes.test.js && node tests/fixture-behavior.test.js && node tests/user-facing-text.test.js && node tests/smoke-test.test.js && node tests/npm-link.test.js && node tests/package-size.test.js --bundle && node tests/extension-host-exit.test.js",
    "test:extension-host": "node tests/extension-host/run.js",
    "test:vsix-install": "node tests/install-vsix.test.js",
    "benchmark:workspace": "node tests/workspace-benchmark.js",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "posttest": "node -e \"const fs=require('fs');fs.rmSync('out',{recursive:true,force:true});fs.rmSync('dist',{recursive:true,force:true});\"",
    "release:check": "npm run audit:production && npm run audit:all && npm run package && npm run test:vsix-install",
    "release": "npm ci && npm run release:check",
    "publish-all": "npm run release"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^7.29.7",
    "@types/babel__traverse": "^7.28.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.1",
    "@types/vscode": "^1.105.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "jest": "^30.4.2",
    "parse5": "^7.3.0",
    "typescript": "^5.9.3",
    "yauzl": "^3.4.0"
  },
  "overrides": {
    "lodash": "4.18.1",
    "@isaacs/brace-expansion": "5.0.9",
    "brace-expansion@^1.0.0": "1.1.18",
    "brace-expansion@^5.0.0": "5.0.9",
    "ajv@^8.0.0": "8.18.0",
    "fast-uri@^3.0.0": "3.1.6",
    "glob@^10.0.0": "10.5.0",
    "glob@^11.0.0": "11.1.0",
    "js-yaml@^3.0.0": "4.3.1",
    "js-yaml@^4.0.0": "4.3.1",
    "jws@^3.2.2": "3.2.3",
    "markdown-it@^14.0.0": "15.0.1",
    "minimatch@^3.0.0": "3.1.4",
    "minimatch@^9.0.0": "9.0.7",
    "minimatch@^10.0.0": "10.2.4",
    "qs@^6.14.0": "6.16.0",
    "undici@^7.0.0": "7.29.0",
    "yauzl@^2.3.1": "3.4.0"
  },
  "icon": "images/icon.png",
  "readme": "docs/USER_GUIDE.md",
  "galleryBanner": {
    "color": "#2D2D2D",
    "theme": "dark"
  },
  "dependencies": {
    "zemdomu": "^1.3.21"
  }
}
